# Supabase project URL (Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key for trusted core services. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# C-012 notification email (PT-03/PT-07). One adaptor for the whole app.
# Leave EMAIL_API_URL empty to keep send attempts pending instead of delivered.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
# Absolute base URL used in email links.
APP_URL=http://localhost:3000
# Token the scheduler sends in `x-notifikasi-token` to POST /api/notifikasi/kirim.
NOTIFIKASI_KIRIM_TOKEN=
