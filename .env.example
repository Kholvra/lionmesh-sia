# Supabase project URL (Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key for trusted core services. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
