{
  "name": "lionmesh-sia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:pg001": "node scripts/verify-pg001-nominal.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" && node --experimental-strip-types scripts/verify-c012-worker.mjs",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:setup": "pnpm check:migrations && node scripts/db-guard.mjs setup && supabase start && supabase db reset",
    "db:reset": "pnpm check:migrations && node scripts/db-guard.mjs reset && supabase db reset",
    "db:seed": "node scripts/db-seed.mjs",
    "db:seed:local": "node scripts/db-seed-local.mjs",
    "db:stop": "supabase stop",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.3"
}
